# kunkunai.top 生产环境变量模板。
# 这个文件可以上传 GitHub，因为这里只能放占位符，不能放真实密钥。
# 部署到服务器时，把它复制成 .env.production，再在 .env.production 里填写真实值。
# 注意：不要把真实数据库密码、API Key、JWT 密钥写进任何 .env*.example 文件。

NODE_ENV=production
PORT=3000

# 正式网站地址，用于服务端回调、任务队列投递等场景。
INTERNAL_BASE_URL=https://kunkunai.top

# PostgreSQL 数据库连接地址。正式环境必须填写真实数据库。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# 登录、内部任务、兑换码用到的密钥。正式环境请使用很长的随机字符串。
JWT_SECRET="replace-with-a-long-random-string"
INTERNAL_WORKER_SECRET="replace-with-another-long-random-string"
REDEEM_CODE_SALT="replace-with-a-long-random-string"

# RunningHub
RUNNINGHUB_API_KEY="replace-with-runninghub-api-key"

# Upstash Redis REST 配置
UPSTASH_REDIS_REST_URL="replace-with-upstash-redis-rest-url"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-redis-rest-token"

# 阿里云 OSS 配置
OSS_BUCKET="replace-with-oss-bucket"
OSS_REGION="oss-cn-shanghai"
OSS_ACCESS_KEY_ID="replace-with-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="replace-with-oss-access-key-secret"
# 如果网站部署在同地域阿里云 ECS，优先用内网 Endpoint。
OSS_ENDPOINT="https://oss-cn-shanghai-internal.aliyuncs.com"
OSS_TEMP_PREFIX="tmp-inputs/"
TEMP_UPLOAD_MAX_MB=50

# 备案公示信息。公安备案审核通过后，把公安备案号和 recordcode 填成真实值。
NEXT_PUBLIC_SITE_OWNER_NAME="坤坤 AI"
NEXT_PUBLIC_ICP_RECORD_NUMBER="请填写ICP备案号"
NEXT_PUBLIC_POLICE_RECORD_NUMBER="请填写公网安备号"
NEXT_PUBLIC_POLICE_RECORD_CODE="请填写公安备案数字编号"
