# kunkunai.top 鐢熶骇鐜鍙橀噺妯℃澘銆?# 杩欎釜鏂囦欢鍙互涓婁紶 GitHub锛屽洜涓鸿繖閲屽彧鑳芥斁鍗犱綅绗︼紝涓嶈兘鏀剧湡瀹炲瘑閽ャ€?# 閮ㄧ讲鍒版湇鍔″櫒鏃讹紝鎶婂畠澶嶅埗鎴?.env.production锛屽啀鍦?.env.production 閲屽～鍐欑湡瀹炲€笺€?# 娉ㄦ剰锛氫笉瑕佹妸鐪熷疄鏁版嵁搴撳瘑鐮併€丄PI Key銆丣WT 瀵嗛挜鍐欒繘浠讳綍 .env*.example 鏂囦欢銆?
NODE_ENV=production
PORT=3000

# 姝ｅ紡缃戠珯鍦板潃锛岀敤浜庢湇鍔＄鍥炶皟銆佷换鍔￠槦鍒楁姇閫掔瓑鍦烘櫙銆?INTERNAL_BASE_URL=https://kunkunai.top

# PostgreSQL 鏁版嵁搴撹繛鎺ュ湴鍧€銆傛寮忕幆澧冨繀椤诲～鍐欑湡瀹炴暟鎹簱銆?DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# 鐧诲綍銆佸唴閮ㄤ换鍔°€佸厬鎹㈢爜鐢ㄥ埌鐨勫瘑閽ャ€傛寮忕幆澧冭浣跨敤寰堥暱鐨勯殢鏈哄瓧绗︿覆銆?JWT_SECRET="replace-with-a-long-random-string"
INTERNAL_WORKER_SECRET="replace-with-another-long-random-string"
REDEEM_CODE_SALT="replace-with-a-long-random-string"
# 微信支付 Native / 退款
WECHAT_MCH_ID="your-wechat-mchid"
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_API_V3_KEY="your-wechat-api-v3-key"
WECHAT_API_CERT_SERIAL_NO="your-merchant-api-cert-serial-no"
WECHAT_API_PRIVATE_KEY_PATH="/www/wwwroot/kunkunai.top/certs/wechat-api-private.pem"
WECHAT_PAY_PUBLIC_KEY_ID="your-wechatpay-public-key-id"
WECHAT_PAY_PUBLIC_KEY_PATH="/www/wwwroot/kunkunai.top/certs/wechatpay-public-key.pem"
WECHAT_NOTIFY_URL="https://kunkunai.top/api/pay/wechat/notify"
WECHAT_REFUND_NOTIFY_URL="https://kunkunai.top/api/pay/wechat/refund-notify"


# RunningHub
RUNNINGHUB_API_KEY="replace-with-runninghub-api-key"

# Upstash Redis REST 閰嶇疆
UPSTASH_REDIS_REST_URL="replace-with-upstash-redis-rest-url"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-redis-rest-token"

# 闃块噷浜?OSS 閰嶇疆
OSS_BUCKET="replace-with-oss-bucket"
OSS_REGION="oss-cn-shanghai"
OSS_ACCESS_KEY_ID="replace-with-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="replace-with-oss-access-key-secret"
# 濡傛灉缃戠珯閮ㄧ讲鍦ㄥ悓鍦板煙闃块噷浜?ECS锛屼紭鍏堢敤鍐呯綉 Endpoint銆?OSS_ENDPOINT="https://oss-cn-shanghai-internal.aliyuncs.com"
OSS_TEMP_PREFIX="tmp-inputs/"
TEMP_UPLOAD_MAX_MB=50

