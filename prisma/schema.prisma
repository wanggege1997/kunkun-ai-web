generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  account           String         @unique
  passwordHash      String
  username          String         @unique
  role              String         @default("user")
  points            Int            @default(5)
  taskBlocked       Boolean        @default(false)
  avatarType        String         @default("default")
  avatarValue       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paymentOrders     PaymentOrder[]
  operatedPointLogs PointLog[]     @relation("PointLogOperator")
  pointLogs         PointLog[]     @relation("PointLogOwner")
  taskRecords       TaskRecord[]
  userState         UserState?
  createdRedeemCodes RedeemCode[]  @relation("RedeemCodeCreator")
  boundRedeemCodes   RedeemCode[]  @relation("RedeemCodeBoundUser")
  usedRedeemCodes    RedeemCode[]  @relation("RedeemCodeUsedByUser")
  redeemCodeUseLogs  RedeemCodeUseLog[]
}

model PointLog {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  reason       String
  relatedId    String?
  operatorId   String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  operator     User?    @relation("PointLogOperator", fields: [operatorId], references: [id])
  user         User     @relation("PointLogOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserState {
  userId      String   @id
  historyJson String   @default("[]")
  queueJson   String   @default("[]")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentOrder {
  id            String    @id @default(cuid())
  orderNo       String    @unique
  userId        String
  channel       String
  amountFen     Int
  points        Int
  status        String    @default("pending")
  clientOrderNo String?
  codeUrl       String?
  timeExpireAt  DateTime?
  closedAt      DateTime?
  gatewayStatus String?
  gatewayCheckedAt DateTime?
  thirdTradeNo  String?
  paidAmountFen Int?
  paidAt        DateTime?
  refundNo      String?
  refundId      String?
  refundAmountFen Int?
  refundReason  String?
  refundStatus  String?
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([refundNo])
}

model TaskRecord {
  id                  String    @id
  userId              String
  requestId           String
  workflowId          String
  workflowTitle       String
  status              String
  taskId              String?
  pointsCost          Int       @default(0)
  resultUrl           String?
  resultType          String?
  error               String?
  payloadJson         String?
  deliveryStatus      String    @default("none")
  deliveryAttempts    Int       @default(0)
  deliveryMaxAttempts Int       @default(5)
  deliveryLastError   String?
  deliveryNextRetryAt DateTime?
  deliveryAckAt       DateTime?
  hiddenAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  pointCapturedAt     DateTime?
  pointReleasedAt     DateTime?
  pointReservedAt     DateTime?
  pointState          String    @default("none")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, status, createdAt])
  @@index([requestId])
  @@index([status, deliveryStatus, deliveryNextRetryAt])
  @@index([userId, hiddenAt, createdAt])
  @@index([pointState, status, updatedAt])
}

model RedeemCode {
  id              String              @id @default(cuid())
  codeHash        String              @unique
  codePreview     String
  mode            String              @default("universal")
  points          Int
  amountFen       Int?
  exchangeRate    Int                 @default(100)
  maxUses         Int                 @default(1)
  usedCount       Int                 @default(0)
  status          String              @default("active")
  expiresAt       DateTime?
  usedAt          DateTime?
  note            String?
  boundUserId     String?
  usedByUserId    String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  boundUser       User?               @relation("RedeemCodeBoundUser", fields: [boundUserId], references: [id], onDelete: SetNull)
  usedByUser      User?               @relation("RedeemCodeUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdByUser   User                @relation("RedeemCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  useLogs         RedeemCodeUseLog[]

  @@index([status, expiresAt])
  @@index([mode, status])
  @@index([boundUserId])
  @@index([usedByUserId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model RedeemCodeUseLog {
  id           String     @id @default(cuid())
  redeemCodeId String
  userId       String
  points       Int
  requestIp    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([redeemCodeId, userId])
  @@index([userId, createdAt])
  @@index([redeemCodeId, createdAt])
}
